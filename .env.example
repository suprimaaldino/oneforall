# ── wa-dino-bot Environment Variables ──

# Backend
PORT=3000
DB_PATH=./data/dinobot.db

# Service URLs (Docker internal)
LLM_SERVICE_URL=http://llm_service:8001
CLASSIFIER_SERVICE_URL=http://classifier_service:8002

# LLM settings
MODEL_PATH=/models/gpt4all-model.bin
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# Bot persona
BOT_NAME=DinoBot
DEFAULT_TONE=auto-detect
SAFETY_LEVEL=normal

# Admin UI
ADMIN_PORT=5173
BACKEND_CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_MS=60000
